PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/govt_scheme_db
# Generate a unique secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Required only when running the demo seed script.
SEED_ADMIN_PASSWORD=
SEED_BENEFICIARY_PASSWORD=

SEED_ALLOW_RESET=false
